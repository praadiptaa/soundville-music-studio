# Port aplikasi
PORT=5000

# Mode Database:
# Untuk Supabase PostgreSQL (Production di Render.com):
# Masukkan URI Koneksi PostgreSQL dari Supabase (Project Settings -> Database -> Connection String -> URI)
DATABASE_URL=postgres://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ATAU jika menggunakan MySQL (Development lokal):
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=soundville_db

# Security & JWT
JWT_SECRET=soundville_jwt_secret_key_2024
JWT_EXPIRES_IN=7d
UPLOAD_PATH=uploads/

# CORS Configuration
CLIENT_URL=http://your-subdomain.infinityfreeapp.com
CORS_ALLOW_ALL=true
